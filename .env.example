# GOOGLE_DRIVE_CLIENT_ID: Required for Google Drive API.
GOOGLE_DRIVE_CLIENT_ID=

# GOOGLE_DRIVE_CLIENT_SECRET: Required for Google Drive API.
GOOGLE_DRIVE_CLIENT_SECRET=

# GOOGLE_DRIVE_REDIRECT_URI: The redirect URI for Google OAuth.
# Usually: ${APP_URL}/api/auth/google/callback
GOOGLE_DRIVE_REDIRECT_URI=
